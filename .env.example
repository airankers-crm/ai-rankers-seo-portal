# Runtime database connection. Use the pooled Neon connection for Vercel functions.
DATABASE_URL=

# Direct Neon connection used by Prisma CLI migrations and status checks.
DIRECT_URL=

# Neon Auth server URL used by the Next.js auth middleware and session helpers.
NEON_AUTH_BASE_URL=

# Strong private secret for signing/authentication cookies. Never commit a value.
NEON_AUTH_COOKIE_SECRET=

# Canonical browser origin used for CSRF/Origin validation, for example https://portal.example.com.
APP_ORIGIN=

# Set to true in a non-production environment to verify fail-closed access behavior.
REQUIRE_AUTH=false

# Base64-encoded 32-byte key used for AES-256-GCM integration secret storage.
INTEGRATION_ENCRYPTION_KEY=

# Google OAuth values. Leave empty until the Google Cloud OAuth client exists.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Server-only bearer secret for scheduled sync requests.
CRON_SECRET=

# Vercel supplies NODE_ENV automatically. Do not commit production secrets here.
