generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CLIENT
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ClientStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SectionKind {
  OVERVIEW
  GBP
  WEBSITE
  CUSTOM
}

enum DisplayType {
  NUMBER_CARD
  PERCENT_CARD
  LINE_CHART
  BAR_CHART
  AREA_CHART
  PROGRESS
  TABLE
}

enum ValueFormat {
  INTEGER
  DECIMAL
  PERCENT
  CURRENCY
  DURATION_SECONDS
  RANK
}

enum DataSource {
  MANUAL
  GSC
  GA4
  GBP
  DATAFORSEO
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  name            String
  passwordHash    String?
  role            Role
  status          UserStatus   @default(INVITED)
  clientId        String?
  client          Client?      @relation(fields: [clientId], references: [id])
  allClients      Boolean      @default(false)
  assignedClients ClientAdmin[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  auditLogs       AuditLog[]
}

model Client {
  id           String        @id @default(cuid())
  businessName String
  slug         String        @unique
  websiteUrl   String?
  contactEmail String?
  timezone     String        @default("America/New_York")
  hasWebsiteSeo Boolean      @default(false)
  hasGbpSeo    Boolean       @default(false)
  status       ClientStatus  @default(ACTIVE)
  users        User[]
  admins       ClientAdmin[]
  sections     Section[]
  metrics      Metric[]
  activities   Activity[]
  reports      Report[]
  versions     DashboardVersion[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model ClientAdmin {
  clientId String
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([clientId, userId])
  @@index([userId])
}

model Section {
  id        String      @id @default(cuid())
  clientId  String
  name      String
  kind      SectionKind
  position  Int         @default(0)
  isVisible Boolean     @default(true)
  isDraft   Boolean     @default(true)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics   Metric[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([clientId, position])
}

model Metric {
  id            String        @id @default(cuid())
  clientId      String
  sectionId     String
  key           String
  name          String
  description   String?
  displayType   DisplayType   @default(NUMBER_CARD)
  valueFormat   ValueFormat   @default(INTEGER)
  source        DataSource    @default(MANUAL)
  higherIsBetter Boolean       @default(true)
  position      Int           @default(0)
  isVisible     Boolean       @default(true)
  isDraft       Boolean       @default(true)
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  values        MetricValue[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([clientId, key])
  @@index([clientId, sectionId, position])
}

model MetricValue {
  id          String     @id @default(cuid())
  metricId    String
  periodStart DateTime
  periodEnd   DateTime
  value       Decimal    @db.Decimal(18, 4)
  source      DataSource
  note        String?
  isOverride  Boolean    @default(false)
  metric      Metric     @relation(fields: [metricId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([metricId, periodStart, periodEnd, source])
  @@index([metricId, periodStart])
}

model DashboardVersion {
  id          String   @id @default(cuid())
  clientId    String
  version     Int
  label       String?
  snapshot    Json
  publishedAt DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, version])
  @@index([clientId, publishedAt])
}

model Activity {
  id          String         @id @default(cuid())
  clientId    String
  title       String
  description String?
  category    String
  status      ActivityStatus @default(PLANNED)
  completedAt DateTime?
  client      Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([clientId, status, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  clientId    String
  title       String
  type        String
  periodLabel String
  storageKey  String?
  isVisible   Boolean  @default(true)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  clientId   String?
  actorId    String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([actorId, createdAt])
}
